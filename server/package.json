{
  "name": "@classops/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "mail:verify": "tsx src/scripts/verify-smtp.ts",
    "mail:worker": "tsx src/workers/mail-worker.ts",
    "mail:worker:once": "tsx src/workers/mail-worker.ts --once"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "argon2": "0.45.1",
    "dotenv": "17.2.3",
    "fastify": "5.12.1",
    "nodemailer": "9.0.6",
    "openid-client": "6.8.7",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
