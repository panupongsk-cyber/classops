# Production secrets for compose.v2.prod.yml. Copy to an out-of-Git path such as
# ~/.life-os/secrets/classops.env (chmod 600) and fill in real values. Never commit real values.

POSTGRES_PASSWORD=
APP_BASE_URL=https://<macmini-name>.<tailnet>.ts.net
SEALED_PAYLOAD_ENCRYPTION_KEY=
ADMIN_GOOGLE_EMAIL=

# Set together only once the OAuth approval gate is granted and a pilot OAuth client exists.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<macmini-name>.<tailnet>.ts.net/api/auth/google/callback

# Set together only once the Microsoft OAuth approval gate is granted and an Azure App
# Registration exists (accepting both organizational and personal Microsoft accounts).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://<macmini-name>.<tailnet>.ts.net/api/auth/microsoft/callback
