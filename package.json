{
  "name": "classops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "v2:db:up": "docker compose -f compose.v2.dev.yml up -d postgres",
    "v2:db:down": "docker compose -f compose.v2.dev.yml down",
    "v2:migrate": "npm --prefix server run db:migrate",
    "v2:dev": "npm --prefix server run dev",
    "v2:build": "npm --prefix server run build",
    "v2:test": "npm --prefix server test",
    "v2:prod:deploy": "bash ops/deploy/deploy.sh",
    "v2:prod:health": "bash ops/deploy/health.sh",
    "v2:prod:backup": "bash ops/deploy/backup.sh",
    "v2:prod:restore": "bash ops/deploy/restore.sh",
    "v2:prod:down": "docker compose -f compose.v2.prod.yml --env-file \"$CLASSOPS_ENV_FILE\" down"
  },
  "dependencies": {
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "react-router-dom": "6.30.3",
    "vite": "^5.4.21",
    "vitest": "2.1.9"
  }
}
